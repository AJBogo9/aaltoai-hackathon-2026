# Copy this to the gitignored local env file ONCE, then fill it in.
# Do not re-run that copy afterwards: it overwrites the key you pasted.

# Inference API key handed out by the partner (Norrin) at the event.
# Different thing from Verda Cloud API credentials, which the CLI keeps in ~/.verda.
VERDA_API_KEY=

# Base URL of the OpenAI-compatible container endpoint, WITHOUT the /v1/... suffix.
VERDA_BASE_URL=https://containers.datacrunch.io/data-sovereignty-mistral-large-3

# The served model id, confirmed against /v1/models on 19 Sep 2026.
# Must match exactly or vLLM answers 400. Leave blank to auto-discover.
VERDA_MODEL=mistralai/Mistral-Large-3-675B-Instruct-2512-NVFP4
