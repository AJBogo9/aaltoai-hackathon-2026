# Generated by scripts/brand.py from design-system/tokens.json and .pi/confidentiality.json. Do not edit.
#
# There is no chart palette. The cycle is ink, because a chart that needs a fourth
# colour is a chart with a fourth claim in it. A level colour is reached for by name
# (design-system/tokens.py, COLOR['text-restricted']) when the line IS that level.

figure.facecolor: fbfbf8
figure.edgecolor: fbfbf8
savefig.facecolor: fbfbf8
figure.dpi: 110
figure.autolayout: True

axes.facecolor: fbfbf8
axes.edgecolor: d8d8d2
axes.labelcolor: 5a5a5a
axes.linewidth: 0.8
axes.grid: True
axes.spines.top: False
axes.spines.right: False
axes.titlesize: 13
axes.titleweight: bold
axes.titlecolor: 0e0e0e
axes.labelsize: 11
axes.prop_cycle: cycler('color', ['0e0e0e', '5a5a5a', '8c8c8c'])

grid.color: d8d8d2
grid.linewidth: 0.6

text.color: 0e0e0e
xtick.color: 8c8c8c
ytick.color: 8c8c8c
xtick.labelcolor: 5a5a5a
ytick.labelcolor: 5a5a5a
xtick.labelsize: 10
ytick.labelsize: 10
xtick.direction: out
ytick.direction: out

font.family: serif
font.serif: PT Serif, DejaVu Serif
font.monospace: PT Mono, DejaVu Sans Mono
font.size: 11

legend.frameon: False
legend.labelcolor: 5a5a5a
lines.linewidth: 1.3

image.cmap: gray
